# Copy to .env.local and fill in what you have. Everything is optional:
# anything not configured runs in a clearly labelled demo mode.

# --- Accounts & database (Supabase) -----------------------------------------
# Without these, the app runs in demo mode and stores data in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used solely by the scheduled recording purge job.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for /api/cron/purge-recordings (Vercel Cron sends it automatically).
CRON_SECRET=

# --- AI evaluation & passage generation (Claude) ----------------------------
ANTHROPIC_API_KEY=
# auto (default: Claude when a key is set) | heuristic (force the demo evaluator)
EVALUATION_PROVIDER=auto
# Model used for evaluation and passage generation.
ANTHROPIC_EVAL_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EVAL_EFFORT=high

# --- Speech-to-text ---------------------------------------------------------
# openai | deepgram. Defaults to whichever key is present, else browser recognition.
STT_PROVIDER=
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Text-to-speech ---------------------------------------------------------
# openai | elevenlabs. Defaults to whichever key is present, else browser voices.
TTS_PROVIDER=
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_MODEL=eleven_multilingual_v2
