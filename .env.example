# Copy to .env.local and fill in what you have. Everything is optional:
# anything not configured runs in a clearly labelled demo mode.

# --- Accounts & database (Supabase) -----------------------------------------
# Without these, the app runs in demo mode and stores data in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used solely by the scheduled recording purge job.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for /api/cron/purge-recordings (Vercel Cron sends it automatically).
CRON_SECRET=

# --- Gemini: evaluation, passage writing, transcription and voices ----------
# One key covers all four. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# auto (default: Gemini when a key is set) | heuristic (force the free demo evaluator)
EVALUATION_PROVIDER=auto
# Model overrides (defaults shown). Try a Flash-Lite model for lower cost.
GEMINI_EVAL_MODEL=gemini-3.8-flash
GEMINI_GENERATE_MODEL=
GEMINI_STT_MODEL=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
# Optional: MINIMAL | LOW | MEDIUM | HIGH. Leave empty for the model default.
GEMINI_THINKING_LEVEL=

# --- API protection when Supabase is NOT configured -------------------------
# With Supabase, callers must be signed in. Without it, set a shared secret and
# send it as the `x-api-key` header (the mobile app reads EXPO_PUBLIC_API_KEY).
API_ACCESS_TOKEN=

# --- Optional alternative speech providers ----------------------------------
# Defaults to Gemini when GEMINI_API_KEY is set. Override with:
# STT_PROVIDER = gemini | openai | deepgram   TTS_PROVIDER = gemini | openai | elevenlabs
STT_PROVIDER=
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

TTS_PROVIDER=
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_MODEL=eleven_multilingual_v2
