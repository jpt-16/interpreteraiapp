# Public values only: everything prefixed EXPO_PUBLIC_ is bundled into the app.
# Never put the Gemini key here; it lives on the server (see ../.env.example).

# Where the Décalage API (the Next.js project in the repo root) is deployed.
# Leave empty for fully offline demo mode (curated passages, on-device scoring, device voices).
EXPO_PUBLIC_API_URL=

# Supabase (optional). Without these the app keeps history on the device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Only when the API runs without Supabase and sets API_ACCESS_TOKEN. This is a deterrent, not a secret:
# it ships inside the app. Prefer Supabase sign-in for anything public.
EXPO_PUBLIC_API_KEY=
